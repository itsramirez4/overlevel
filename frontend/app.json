{
  "expo": {
    "name": "Overlevel",
    "slug": "overlevel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/png/1024x1024/app-icon-1024x1024.png",
    "userInterfaceStyle": "dark",
    "scheme": "overlevel",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.overlevel.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/png/1024x1024/logo-icon-1024x1024.png",
        "backgroundColor": "#0A0E27"
      },
      "package": "com.overlevel.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/png/layouts/logo-vertical.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0E27"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/png/1024x1024/logo-icon-bw-1024x1024.png",
          "color": "#FF5A4A"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "8c9fdd4d-3887-4797-8f1d-dd1528541ccd"
      }
    },
    "owner": "itsramirez4",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8c9fdd4d-3887-4797-8f1d-dd1528541ccd"
    }
  }
}
