# Environment
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Comma-separated browser origins allowed by CORS (native app requests have no
# Origin header and are unaffected). Not needed for local dev — localhost/LAN
# origins are allowed automatically outside production.
ALLOWED_ORIGINS=

# Supabase
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_ACCESS=15m
JWT_EXPIRE_REFRESH=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cron Jobs
ENABLE_CRON_JOBS=true

# Logging
LOG_LEVEL=debug

# Error tracking (optional) — leave unset to disable Sentry entirely.
# Also receives client-side errors reported via POST /api/client-errors.
SENTRY_DSN=

# Shared secret GitHub Actions' scheduled workflows send as X-Cron-Secret
# when calling POST /api/internal/cron/* — used instead of the in-process
# node-cron scheduler on a host whose free tier sleeps when idle. Generate
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Comma-separated user ids allowed to edit/delete any exercise, not just
# their own (exercises are shared across users — see exerciseService).
# Find your own id via GET /users/me.
ADMIN_USER_IDS=

# Self-service signup (POST /api/auth/register) — closed unless this is
# exactly "true". Accounts are provisioned in the Supabase Auth dashboard
# while it's closed.
ENABLE_SELF_REGISTRATION=
