# Environment
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Comma-separated browser origins allowed by CORS (native app requests have no
# Origin header and are unaffected). Not needed for local dev — localhost/LAN
# origins are allowed automatically outside production.
ALLOWED_ORIGINS=

# Supabase
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRE_ACCESS=15m
JWT_EXPIRE_REFRESH=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cron Jobs
ENABLE_CRON_JOBS=true

# Logging
LOG_LEVEL=debug
